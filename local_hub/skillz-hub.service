[Unit]
Description=Skillz Media Local Hub
Documentation=https://github.com/Coachskillz/jetson-media-player
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=skillz
Group=skillz
WorkingDirectory=/home/skillz/skillz-hub
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/skillz/skillz-hub/start_hub.sh

Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skillz-hub

[Install]
WantedBy=multi-user.target
